            "target_duration_seconds": 7.0,
            "actual_duration_seconds": 5.424,
            "difference_seconds": -1.576,
            "within_target": true,
            "dialogue": "सत्या का विवाह विदर्भ के राजा से हुआ, जिससे पांडवों और विदर्भ के बीच गठबंधन बना।"
