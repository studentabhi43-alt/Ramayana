            "target_duration_seconds": 7.0,
            "actual_duration_seconds": 5.664,
            "difference_seconds": -1.336,
            "within_target": true,
            "dialogue": "हालाँकि, यह विवरण मुख्यतः एक पौराणिक कथा है, और ऐतिहासिक प्रमाण सीमित हैं।"
