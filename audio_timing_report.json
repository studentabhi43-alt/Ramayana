            "target_duration_seconds": 7.0,
            "actual_duration_seconds": 5.424,
            "difference_seconds": -1.576,
            "within_target": true,
            "dialogue": "उत्तरा काण्ड में सिता का निर्वासन और राक्षस राजा से मुलाकात का विस्तृत वर्णन मिलता है।"
