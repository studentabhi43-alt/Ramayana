            "target_duration_seconds": 7.0,
            "actual_duration_seconds": 5.328,
            "difference_seconds": -1.672,
            "within_target": true,
            "dialogue": "यह कहानी वान पर्व में मिलती है, जहाँ पांडवों के परिवार के बारे में विस्तृत वर्णन है।"
