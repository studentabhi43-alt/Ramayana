            "target_duration_seconds": 7.0,
            "actual_duration_seconds": 6.528,
            "difference_seconds": -0.472,
            "within_target": true,
            "dialogue": "यदि यह सत्य है, तो महाभारत प्राचीन भारतीय संस्कृति के खेल इतिहास में एक महत्वपूर्ण स्थान रखता है।"
